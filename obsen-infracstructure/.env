# =========================================================================
# CONFIGURATION BASE DE DONNÉES (POSTGRESQL)
# =========================================================================
POSTGRES_USER=obsen_user
POSTGRES_PASSWORD=obsen_password
POSTGRES_DB=obsen_sre_db

# Aligné pour le Spring Boot Backend qui cherche cette clé spécifique
DB_PASSWORD=obsen_password

# =========================================================================
# CONFIGURATION INTERFACE DE GESTION (PGADMIN)
# =========================================================================
PGADMIN_EMAIL=admin@obsen.com
PGADMIN_PASSWORD=admin_password

# =========================================================================
# CONFIGURATION GESTION DES ACCÈS (KEYCLOAK)
# =========================================================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# =========================================================================
# CONFIGURATION GESTION DE PARC (GLPI / OPTION POSTGRESQL)
# =========================================================================
# (Note : GLPI_DB_PASSWORD utilisera automatiquement la valeur de POSTGRES_PASSWORD)
GLPI_DB_PASSWORD=obsen_password